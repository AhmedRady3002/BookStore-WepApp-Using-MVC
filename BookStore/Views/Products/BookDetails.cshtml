@model BookDEtailsViewModel

<div class="book lh-lg">
	<div class="row">
		<div class="col-lg-4 col-md-4">
			<img src="/images/@Model.ImageURL" alt="Alternate Text" />
		</div>
		<div class="col-lg-8 col-md-8 ">
			<h3 class="title">@Model.bookname</h3>
			<p class="text-white author_name">@Model.Author_Name</p>
			 <div class="text-success bg-white fw-bold price ">  @Model.price.ToString("0.00") $</div>
			@if (Model.Quantity > 0)
			{
						<p class="text-info fw-bold">الكميه المتاحه:<span class="text-warning pe-3 fw-bold "> @Model.Quantity</span></p>
			}
			else
			{
					<p class="text-danger">Not Available</p>
			}
			
			<p class="description " >@Model.description</p>
		

			<div class="mt-5">
				<form >
					<div asp-validation-summary="All" class="text-danger"></div>
					<input type="number" name="QuantityRequired" value="QuantityRequired" class="number-input" />
					<input type="hidden" name="bookid" value="@Model.bookid" class="number-input" />
					<div>
					<input type="submit" value="AddtoCart" class="btn btn-primary mt-3" asp-action="AddToCart" asp-controller="Products" />
					<input type="submit"  value="شراء" class="btn  btn-success mt-3" asp-action="ProcessOfBilling" asp-controller="Products" />
			      </div>
				</form>
			</div>
			@if (User.Identity.IsAuthenticated)
			{
					<div><a href="/Products/SeeCart" class="btn btn-primary mt-3">See Cart</a></div>
			}
				
		<div><a asp-action="showproduct" asp-controller="products" class="btn btn-info mt-3">Back to Home </a></div>


			@if (TempData["SuccessMessage"] != null)
			{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
					@TempData["SuccessMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
			}
			@if (TempData["CreateUser"] != null)
			{
			<div class="alert alert-primary alert-dismissible fade show mt-2" role="alert">
					@TempData["CreateUser"]
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
			}
			@if (TempData["QuantityNotAvailabe"] != null)
			{
				<div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
					@TempData["QuantityNotAvailabe"]
					<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				</div>
			}

		</div>
	</div>

</div>
<style>
	.price
	{
		font-size:20px;
		 width: fit-content;
	}
	.author_name
	{
		 position: relative;
	}
	.author_name::before {
   content: "";
	position: absolute;
	bottom: -8px;     
	left: 0;
	width: 100%;
	height: 1px;       
	background: white;;
}


	.description
	{
		 position: relative;
		 font-weight:600;

	}
	.description::before {
   content: "";
	position: absolute;
	bottom: -35px;      
	left: 0;
	width: 100%;
	height: 1px;    
	background: white;;
}


.number-input {
	width: 200px;           
	padding: 8px 12px;      
	border: 2px solid #ccc; 
	border-radius: 6px;    
	font-size: 16px;
	transition: 0.3s;
}

.number-input:focus {
	border-color: #4CAF50; 
	outline: none;
	box-shadow: 0 0 5px rgba(76, 175, 80, 0.4);
}

input[type="number"]::-webkit-inner-spin-button {
	transform: scale(1.5);
	cursor: pointer;
}


</style>
 

