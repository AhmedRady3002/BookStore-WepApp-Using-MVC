
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookStore.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" 
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display+SC:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display+SC:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&family=Playwrite+NZ+Basic:wght@100..400&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">


<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display+SC:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 sticky-top ">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Products" asp-action="ShowProduct">BookStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
              
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between ">
                    <ul class="navbar-nav flex-grow-1 ">
                          <li class="nav-item ">
                                    <a class="nav-link " asp-action="ShowProduct" asp-controller="Products"> Home</a> 
                            </li>
                           <li class="nav-item ">
                                   <form asp-action="Search" method="post" class="Search" asp-controller="Products">
                                   <input class="form form-control "name="Name" placeholder="BookName" />
                                   <input type="submit" value="Search" class="btn btn-primary ms-1" />
                                 </form>
                            </li>
                          @if (User.IsInRole("Admin"))
                          {
                                <li class="nav-item ">
                                    <a class="nav-link " href="/Admin/CategoryAdmin"> Category</a> 
                            </li>
                            <li class="nav-item ">
                                 <a class="nav-link " href="/Admin/AuthorAdmin"> Author </a>
                            </li>
                             <li class="nav-item ">
                                 <a class="nav-link " href="/Admin/BookAdmin"> Book </a>
                            </li>
                             <li class="nav-item ">
                                 <a class="nav-link " href="/Admin/Register"> ReisterAdmin </a>
                            </li>
                                 <li class="nav-item">
                                <a class="nav-link " asp-action="AddROle" asp-controller="Admin">Role</a>
                              
                            </li>
                                 <li class="nav-item">
                                    <a class="nav-link " asp-action="GetOrders" asp-controller="Admin">Orders</a>

                                </li>

                          }
                        @if (User.Identity.IsAuthenticated)
                        {
                                  <Li class="nav-item text-white" >
                                                <a class="nav-link  " asp-action="SeeCart" asp-controller="Products">Cart</a>
                                                 </Li>
                                   <li class="nav-item  ms-auto">
                                     <a class="nav-link text-dark " href="/Admin/LogOut"> LogOut </a>
                                </li>
                                    
                        
                        }
                        @if (User.Identity.IsAuthenticated != true)
                        {
                                 <div class="d-flex flex-row-reverse ms-auto ">
                                         <li class="nav-item  ">
                                     <a class="nav-link t" href="/UserAccount/LogIn"> LogIn </a>
                                </li>

                                      <li class="nav-item ">
                                     <a class="nav-link " href="/UserAccount/Register"> Register </a>
                                </li>
                             </div>
                        }
                       
                       <Li>
                           <a asp-action=""></a>
                       </Li>
                    
                        @if (User.Identity.IsAuthenticated)
                        {
                                
                                       
                                    <div class="profile mt-auto mb-auto">
                                              <li class=" nav-item  text-white">@User.Identity.Name <i class="fa-solid fa-user  text-dark"></i> </li>
                               
                                     @*   @{
                                         var idclaim = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier);
                                                 <li class="nav-item " >@idclaim.Value</li>
                                     } *@
                              
                                    </div>
                        }
                        
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BookStore - <a asp-area="" asp-controller="UserAccount" asp-action="Register">Register</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
