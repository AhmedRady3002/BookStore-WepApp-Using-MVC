@model BookStore.ModelView.AddCategoryNameViewModel
@{
     Layout = "_Layout";
}

<h4>AddCategoryName</h4>
<hr />
<div class="row">

    <div class="col-md-6">

        <form asp-action="SaveCategory">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CategoryName" class="control-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
            <div class="form-group text-center mt-3">
                <input type="submit" value="Save" class="btn btn-primary " />
            </div>
        </form>

   <div class="text-center mt-3">
        <a asp-controller="Products" asp-action="ShowProduct" >Back to List</a>
   </div>
    </div>




      <div class="col-md-6">
        <table class="table table-hover table-dark">
    <tr>
        <td>ID</td>
        <td>Name</td>
        <td>Modeify</td>
        <td>Remove</td>
    </tr>
            @foreach (var item in ViewBag.Categories)
            {
                    <tr>
                               <td>@item.Id</td>
                             <td>@item.Name</td>
                             <td><a href="/Admin/EditCategory/@item.Id" class="btn btn-success">Edite</a></td>
                                 <td> <a href="/Admin/DeleteCategory/@item.Id" class="btn btn-danger"> Delete </a> </td>
                    </tr>
            }
        </table>
    </div>
  

</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
