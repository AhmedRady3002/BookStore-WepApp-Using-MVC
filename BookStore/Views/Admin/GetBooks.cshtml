@model List<(int bookid, string bookname, double price,int Quantity,string ImageURL,string Category_Name,string Author_Name,string Date)> 

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-dark text-white rounded-top-4">
            <h5 class="mb-0">Books</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Category</th>
                        <th>Author</th>
                        <th>Publication Date</th>
                        <th>ImageURL</th>
                        <th>Modify</th>
                        <th>Remove</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                            <tr>
                                <td class="fw-bold">@item.bookid</td>
                                <td>@item.bookname</td>
                                    
                                <td class="text-success fw-semibold">
                                @item.price.ToString("0.00") $
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                    @item.Quantity
                                    </span>
                                </td>
                                <td>@item.Category_Name</td>
                                <td>@item.Author_Name</td>
                                 <td>
                                     <small class="text-muted">
                                     @item.Date
                                     </small>
                                 </td>
                                     <td>@item.ImageURL</td>
                                <td>
                                    <a href="/Admin/EditeBook/@item.bookid"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        Edit
                                    </a>
                                </td>
                                     <td>
                                            <a href="/Admin/DeleteBook/@item.bookid"
                                           class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            Delete
                                        </a>
                                    </td>
                            </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>


