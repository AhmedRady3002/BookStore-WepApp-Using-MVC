@model BookStore.ModelView.AddAuthorViewModel
@{
    Layout = "_Layout";
}

<h4>AddAuthor</h4>
<hr />
<div class="row">

    <div class="col-md-6">
        <form asp-action="SaveAuthor">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group text-center mt-3">
                <input type="submit" value="Save" class="btn btn-primary " />
            </div>
        </form>
        <div class="text-center mt-3">
         <a asp-controller="Products" asp-action="ShowProduct">Back to List</a>
         </div>
    </div>
    <div class="col-md-6">
        <table class="table table-hover table-dark ">
    <tr>
        <td>ID</td>
       <td>Name</td>
       <td>Modify</td>
       <td>Remove</td>
    </tr>
            @foreach (var item in ViewBag.Authors)
            {
                <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                              <td>
                                    <a href="/Admin/EditeAuthor/@item.Id" class="btn btn-success Editbtn">Edit</a>
                            </td>
                            <td>
                                    <a href="/Admin/DeleteAuthor/@item.Id" class="btn btn-danger Deletebtn">Delete</a>
                            </td>
                </tr>                
            }
        </table>
        
     <div/>

</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

