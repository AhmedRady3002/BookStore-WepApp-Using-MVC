<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>
    const token = prompt("Enter JWT Token:");

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("http://localhost:5015/notificationHub", {
            accessTokenFactory: () => token
        })
        .withAutomaticReconnect()
        .build();

    connection.on("NewRequstJoinNotification", (notification) => {
        console.log("New Request:", notification);
    });

    connection.on("ApprovedJoinNotification", (notification) => {
        console.log("Approved:", notification);
    });

    connection.on("ResponseJoinNotification", (notification) => {
        console.log("Response:", notification);
    });

    connection.start()
        .then(() => console.log("Connected"))
        .catch(err => console.error(err));
</script>